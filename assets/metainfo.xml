            </description>
        </release>
        
        <release version="1.0.0" date="2025-03-27">
            <url type="details">https://github.com/l0drex/wallpaper_splitter/releases/tag/v1.0.0</url>
            <description>
                <p>Initial Release</p>
                <ul>
                    <li>Save wallpaper to disk</li>
