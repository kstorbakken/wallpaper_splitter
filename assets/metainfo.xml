<component type="desktop-application">
    <id>io.github.kstorbakken.wallpaper_splitter</id>
    
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-only</project_license>
    
    <name>Wallpaper Splitter</name>
    <summary>Split wallpaper images for multi-monitor usage</summary>

    <developer id="io.github.kstorbakken">
        <name>Wallpaper Splitter contributors</name>
    </developer>

    <description>
        <p>
            This app detects the size and layout of your monitors
            and cuts an image so it can be applied as a wallpaper spreading across your monitors.
            You can save the image to the disk (e.g., for slideshows) or directly apply it.
        </p>
    </description>

    <launchable type="desktop-id">io.github.kstorbakken.wallpaper_splitter.desktop</launchable>

    <requires>
        <control>keyboard</control>
        <control>pointing</control>
        <display_length compare="ge">768</display_length>
    </requires>
    
    <icon type="stock">io.github.kstorbakken.wallpaper_splitter</icon>
    
    <branding>
        <color type="primary" scheme_preference="light">#ccdffb</color>
        <color type="primary" scheme_preference="dark">#3e668e</color>
    </branding>

    <content_rating type="oars-1.1" />

    <url type="homepage">https://github.com/kstorbakken/wallpaper_splitter</url>
    <url type="bugtracker">https://github.com/kstorbakken/wallpaper_splitter/issues</url>
    <url type="contribute">https://github.com/kstorbakken/wallpaper_splitter/blob/main/CONTRIBUTING.md</url>
    <url type="vcs-browser">https://github.com/kstorbakken/wallpaper_splitter</url>

    <screenshots>
        <screenshot type="default">
            <caption>The app shows the wallpaper with the monitor layout layered on top.</caption>
            <image>https://raw.githubusercontent.com/kstorbakken/wallpaper_splitter/main/assets/screenshot.png</image>
        </screenshot>
    </screenshots>
    
    <releases>
        <release version="1.1.4" date="2026-08-11">
            <url type="details">https://github.com/kstorbakken/wallpaper_splitter/releases/tag/v1.1.4</url>
            <description>
                <p>Changed:</p>
                <ul>
                    <li>Development and releases now continue from the actively maintained fork.</li>
                    <li>Application metadata now uses the fork's GitHub-based ID.</li>
                    <li>Added automated build and regression test coverage.</li>
                </ul>
                <p>Fixed:</p>
                <ul>
                    <li>Generate the correct wallpaper sections for multi-monitor layouts.</li>
                </ul>
            </description>
        </release>

        <release version="1.1.3" date="2025-09-18">
            <url type="details">https://github.com/l0drex/wallpaper_splitter/releases/tag/v1.1.3</url>
            <description>
                <p>Changed:</p>
                <ul>
                    <li>Rename file correctly</li>
                    <li>Icon is now optimized</li>
                </ul>
                <p>Fix:</p>
                <ul>
                    <li>Icon not loading</li>
                </ul>
            </description>
        </release>
        
        <release version="1.1.2" date="2025-09-18">
            <url type="details">https://github.com/l0drex/wallpaper_splitter/releases/tag/v1.1.2</url>
            
            <description>
                <p>Change:</p>
                <ul>
                    <li>Text has now a more legible size</li>
                    <li>Model number of the screens is now displayed</li>
                    <li>Improved visuals a bit</li>
                </ul>
            </description>
        </release>

        <release version="1.1.1" date="2025-09-17">
            <url type="details">https://github.com/l0drex/wallpaper_splitter/releases/tag/v1.1.1</url>
            <description>
                <p>Change:</p>
                <ul>
                    <li>Updated urls in metadata to point to new repository url</li>
                </ul>
            </description>
        </release>
        
        <release version="1.1.0" date="2025-09-17">
            <url type="details">https://github.com/l0drex/wallpaper_splitter/releases/tag/v1.1.1</url>
            <description>
